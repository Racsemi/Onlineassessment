# Global
NODE_ENV="development"
PRODUCT_NAME="AssessPro"

# Database
DATABASE_URL="postgresql://root:password@localhost:5432/racsemi?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Secrets
SESSION_SECRET="CHANGE_ME_IN_PRODUCTION"
JWT_SECRET="CHANGE_ME_IN_PRODUCTION"

# App URLs
APP_URL="http://localhost:3000"
API_URL="http://localhost:5000"
CANDIDATE_URL="http://localhost:3001"
ADMIN_URL="http://localhost:3002"

# Email
SMTP_HOST="localhost"
SMTP_PORT="1025"
SES_ACCESS_KEY=""
SES_SECRET_KEY=""

# Storage
AWS_REGION="us-east-1"
AWS_S3_BUCKET_PRIVATE="racsemi-private-dev"
